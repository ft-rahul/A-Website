# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment variables (keep secrets out of git)
.env
.env.*
!.env.example

# Course videos are large local media (GitHub rejects files > 100 MB).
# Keep the folder README; drop the videos onto each machine by hand.
src/assets/courses/**/*.mp4
src/assets/courses/**/*.webm
src/assets/courses/**/*.m4v
src/assets/courses/**/*.mov
src/assets/courses/**/*.ogv

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite cache
.vite/
node_modules/.vite/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.suo
